# Copy to .env (git-ignored) and fill in. All four credentials are required in live mode (npm run dev).
# Sample-data mode (npm run dev:mock) needs none of them.

# Login with Amazon credentials of your SP-API application, authorized by the selling partner
LWA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LWA_CLIENT_SECRET=amzn1.oa2-cs.v1.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LWA_REFRESH_TOKEN=Atzr|xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Selling partner id: a seller's merchant token (Seller Central > Settings > Account Info > Your Merchant Token)
# or a vendor code. The Listings Items API takes it in the request path; no SP-API operation returns it.
SP_API_SELLER_ID=A1XXXXXXXXXXXX

# seller (default) or vendor. Sellers create EBC documents that render under "Product description";
# vendors create EMC documents that render under "From the manufacturer". Also honoured in sample-data mode.
SP_API_ACCOUNT_TYPE=seller

# Region and marketplace
SPAPI_ENDPOINT=https://sellingpartnerapi-na.amazon.com
MARKETPLACE_ID=ATVPDKIKX0DER

# Local port (loopback only)
PORT=8787
