  "tracks": [
    {
      "id": "orders-mfn",
      "title": "Orders → Merchant Fulfilled",
      "description": "Find the unshipped MFN order, confirm shipment yourself, verify it flipped to SHIPPED.",
      "steps": [
        {
          "title": "Find unshipped MFN orders",
          "method": "GET",
          "path": "/orders/2026-01-01/orders?marketplaceIds=ATVPDKIKX0DER&createdAfter=2026-08-01T00:00:00Z&fulfillmentStatuses=UNSHIPPED",
          "status": "runnable",
          "note": "searchOrders — returns both unshipped orders (111-0000001-0000001 MFN, 111-0000002-0000002 FBA)."
        },
        {
          "title": "Get the order details",
          "method": "GET",
          "path": "/orders/2026-01-01/orders/111-0000001-0000001?includedData=BUYER,RECIPIENT,FULFILLMENT",
          "status": "runnable",
          "note": "getOrder — shows shipping address and current fulfillment status."
        },
        {
          "title": "Confirm shipment",
          "method": "POST",
          "path": "/orders/v0/orders/111-0000001-0000001/shipmentConfirmation",
          "status": "runnable",
          "note": "confirmShipment — flips order to SHIPPED and creates a package entry.",
          "body": {
            "packageDetail": {
              "packageReferenceId": "PKG-MFN-1",
              "carrierCode": "UPS",
              "shipDate": "2026-08-12T10:00:00Z",
              "trackingNumber": "1Z999AA10123456784",
              "orderItems": [{ "orderItemId": "ITEM-MFN-0001", "quantity": 1 }]
            },
            "marketplaceId": "ATVPDKIKX0DER"
          }
        },
        {
          "title": "Verify shipped status",
          "method": "GET",
          "path": "/orders/2026-01-01/orders/111-0000001-0000001?includedData=FULFILLMENT,PACKAGES",
          "status": "runnable",
          "note": "getOrder — fulfillmentStatus is now SHIPPED; package with tracking appears."
        }
      ]
    },
    {
      "id": "orders-fba",
      "title": "Orders → FBA Fulfilled",
      "description": "The FBA order is fulfilled by Amazon — observe the inventory deduction and order state.",
      "steps": [
        {
          "title": "Find unshipped FBA orders",
          "method": "GET",
          "path": "/orders/2026-01-01/orders?marketplaceIds=ATVPDKIKX0DER&createdAfter=2026-08-01T00:00:00Z&fulfillmentStatuses=UNSHIPPED",
          "status": "runnable",
          "note": "searchOrders — returns both unshipped orders; identify the FBA one by fulfilledBy: AMAZON."
        },
        {
          "title": "Get the FBA order details",
          "method": "GET",
          "path": "/orders/2026-01-01/orders/111-0000002-0000002?includedData=BUYER,RECIPIENT,FULFILLMENT",
          "status": "runnable",
          "note": "getOrder — fulfilledBy is AMAZON."
        },
        {
          "title": "Check FBA inventory levels",
          "method": "GET",
          "path": "/fba/inventory/v1/summaries?granularityType=Marketplace&granularityId=ATVPDKIKX0DER&marketplaceIds=ATVPDKIKX0DER&sellerSkus=LAUNCH-SKU-001&details=true",
          "status": "runnable",
          "note": "getInventorySummaries — shows current fulfillable/inbound quantities for the SKU."
        }
      ]
    },
    {
      "id": "repricing",
      "title": "Repricing",
      "description": "Check competitive pricing, estimate fees, adjust your price, and measure the impact.",
      "steps": [
        {
          "title": "Get the competitive summary",
          "method": "POST",
          "path": "/batches/products/pricing/2022-05-01/items/competitiveSummary",
          "status": "pass-through",
          "note": "getCompetitiveSummary — proxied to SP-API production; requires a valid access token."
        },
        {
          "title": "Search the catalog for context",
          "method": "GET",
          "path": "/catalog/2022-04-01/items?identifiers=B0LAUNCH01&identifiersType=ASIN&marketplaceIds=ATVPDKIKX0DER",
          "status": "runnable",
          "note": "searchCatalogItems — returns the seeded catalog item."
        },
        {
          "title": "Adjust the listing price",
          "method": "PATCH",
          "path": "/listings/2021-08-01/items/YOUR_SELLER_ID/LAUNCH-SKU-001?marketplaceIds=ATVPDKIKX0DER",
          "status": "runnable",
          "note": "patchListingsItem — the listing is seeded at $49.99; patch to update the price.",
          "body": {
            "productType": "PRODUCT",
            "patches": [
              {
                "op": "replace",
                "path": "/attributes/purchasable_offer",
                "value": [
                  {
                    "marketplace_id": "ATVPDKIKX0DER",
                    "currency": "USD",
                    "our_price": [{ "schedule": [{ "value_with_tax": 44.99 }] }]
                  }
                ]
              }
            ]
          }
        },
        {
          "title": "Measure order velocity",
          "method": "GET",
          "path": "/orders/2026-01-01/orders?marketplaceIds=ATVPDKIKX0DER&createdAfter=2026-08-10T00:00:00Z",
          "status": "runnable",
          "note": "searchOrders — compare order volume before/after the price change."
        }
      ]
    },
    {
      "id": "returns",
      "title": "Returns",
      "description": "Handle a customer return — from reason codes to the return item lifecycle.",
      "steps": [
        {
          "title": "List return reason codes",
          "method": "GET",
          "path": "/fba/outbound/... (listReturnReasonCodes)",
          "status": "planned",
          "note": "The Fulfillment Outbound API is not onboarded yet."
        },
        {
          "title": "Create a fulfillment return",
          "method": "PUT",
          "path": "/fba/outbound/... (createFulfillmentReturn)",
