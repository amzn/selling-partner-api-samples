        },
        {
          "title": "Watch return status transition",
          "method": "GET",
          "path": "/externalFulfillment/2024-09-11/returns",
          "status": "planned",
          "note": "External Fulfillment Returns — no handler registered yet."
        }
      ]
    },
    {
      "id": "fba-inbound",
      "title": "FBA Inbound Replenishment",
      "description": "Replenish FBA inventory — eligibility, prep, packing, placement, transportation.",
      "steps": [
        {
          "title": "Check current inventory",
          "method": "GET",
          "path": "/fba/inventory/v1/summaries?granularityType=Marketplace&granularityId=ATVPDKIKX0DER&marketplaceIds=ATVPDKIKX0DER&sellerSkus=LAUNCH-SKU-001&details=true",
          "status": "runnable",
          "note": "getInventorySummaries — LAUNCH-SKU-001 has 45 fulfillable + 5 inbound."
        },
        {
          "title": "Check FBA eligibility",
          "method": "GET",
          "path": "/fba/inbound/v1/eligibility/itemPreview (getItemEligibilityPreview)",
          "status": "planned",
          "note": "The FBA Inbound Eligibility API is not onboarded yet."
        },
        {
          "title": "Create the inbound plan",
          "method": "POST",
          "path": "/inbound/fba/2024-03-20/inboundPlans (createInboundPlan)",
          "status": "planned",
          "note": "The Fulfillment Inbound v2024 API is not onboarded yet."
        },
        {
          "title": "Generate and confirm options (packing → placement → transportation)",
          "method": "POST",
          "path": "/inbound/fba/2024-03-20/inboundPlans/{id}/...",
          "status": "planned",
          "note": "The three generate/confirm option pairs — not onboarded yet."
        },
        {
          "title": "Poll the inbound operation status",
          "method": "GET",
          "path": "/inbound/fba/2024-03-20/operations/{operationId}",
          "status": "planned",
          "note": "Not onboarded yet."
        }
      ]
    }
