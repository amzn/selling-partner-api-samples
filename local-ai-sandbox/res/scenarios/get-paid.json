  "tracks": [
    {
      "id": "reconcile-earnings",
      "title": "Reconcile Earnings",
      "description": "See what you earned this period and how released funds differ from deferred ones.",
      "steps": [
        {
          "title": "List all October transactions",
          "method": "GET",
          "path": "/finances/2024-06-19/transactions?marketplaceId={{MARKETPLACE_ID}}&postedAfter=2026-10-01T00:00:00Z&postedBefore=2026-11-01T00:00:00Z",
          "status": "runnable",
          "note": "listTransactions — returns all four seeded transactions (two sales, a refund, a fee) for the region's primary marketplace."
        },
        {
          "title": "Filter to released funds only",
          "method": "GET",
          "path": "/finances/2024-06-19/transactions?marketplaceId={{MARKETPLACE_ID}}&transactionStatus=RELEASED",
          "status": "runnable",
          "note": "listTransactions — excludes the DEFERRED sale, leaving the released sale, refund, and fee. Deferred funds are not yet payable."
        },
        {
          "title": "Read the period summary",
          "method": "GET",
          "path": "/finances/2024-06-19/summary?periodStart=2026-10-01&periodEnd=2026-10-31",
          "status": "runnable",
          "note": "listSummary — returns the SUMMARY record with netProceeds for October. The period overlaps the seeded summary window."
        }
      ]
    },
    {
      "id": "check-balance",
      "title": "Check Available Balance",
      "description": "Find out how much is actually available to pay out, versus held in reserve or still deferred.",
      "steps": [
        {
          "title": "List balances across all marketplaces",
          "method": "GET",
          "path": "/finances/2024-06-19/balances",
          "status": "runnable",
          "note": "listBalances — returns three balances: AVAILABLE 420.17, DEFERRED 89.50, RESERVED 35.00 (in the region's currency). Only AVAILABLE is withdrawable."
        },
        {
          "title": "Filter to the available balance",
          "method": "GET",
          "path": "/finances/2024-06-19/balances?balanceType=AVAILABLE",
          "status": "runnable",
          "note": "listBalances — balanceType narrows to just the AVAILABLE balance, the amount you can request as a payout."
        }
      ]
    },
    {
      "id": "request-payout",
      "title": "Request a Payout",
      "description": "Pick a payment method and pull your available balance to the bank — then watch the guardrails. On-demand payouts are EU-only.",
      "steps": [
        {
          "title": "List saved payment methods",
          "method": "GET",
          "path": "/finances/transfers/2024-06-01/paymentMethods?marketplaceId={{MARKETPLACE_ID}}",
          "status": "runnable",
          "note": "getPaymentMethods — returns the BANK_ACCOUNT (tail 6789) and CARD (tail 4321). CARD-only countryCode/expiryDate appear only on the card. EU-only: a non-EU marketplaceId is rejected regardless of REGION."
        },
        {
          "title": "Initiate an on-demand payout (EU region only)",
          "method": "POST",
          "path": "/finances/transfers/2024-06-01/payouts",
          "status": "runnable",
          "note": "initiatePayout — creates a new PENDING payout and returns payoutReferenceId. EU-only; marketplaceId and accountType are both required.",
          "body": {
            "marketplaceId": "{{MARKETPLACE_ID}}",
            "accountType": "STANDARD_ORDERS"
          }
        },
        {
          "title": "Try again within 24h (expect 429; EU region only)",
          "method": "POST",
          "path": "/finances/transfers/2024-06-01/payouts",
          "status": "runnable",
          "note": "initiatePayout — a second request for the same marketplace and account type within 24 hours returns 429 QuotaExceeded. Only one on-demand payout per marketplace+accountType per day.",
          "body": {
            "marketplaceId": "{{MARKETPLACE_ID}}",
            "accountType": "STANDARD_ORDERS"
          }
        },
        {
          "title": "List payouts to confirm it is PENDING",
          "method": "GET",
          "path": "/finances/transfers/2024-06-01/payouts",
          "status": "runnable",
          "note": "listPayouts — returns your new PENDING payout plus the prior PAID payout, newest first. REGION-driven marketplaceIds filter, so run with REGION=EU."
        }
      ]
    },
    {
      "id": "forecast-payouts",
      "title": "Forecast Upcoming Payouts",
      "description": "Look ahead at scheduled payouts before they land. On-demand payouts are EU-only.",
      "steps": [
        {
          "title": "List expected payouts",
          "method": "GET",
          "path": "/finances/transfers/2024-06-01/payouts/expected",
          "status": "runnable",
          "note": "listExpectedPayouts — returns the SCHEDULED expected payout of 420.17 due 2026-10-21, ordered by scheduledDate descending. REGION-driven marketplaceIds filter, so run with REGION=EU."
        }
      ]
    }
  ]
}
